{
    "name": "osadle",
    "main": "src/index.ts",
    "compatibility_date": "2026-11-13",
    "build": {
        "watch_dir": ["public", "src"]
    },
    "observability": {
        "enabled": true
    },
    "triggers": {
        "crons": ["0 * * * *"]
    },
    "assets": {
        "directory": "./public",
        "binding": "public",
        "run_worker_first": true
    },
    "d1_databases": [
        {
            "binding": "osadle",
            "database_name": "osadle",
            "database_id": "b094f8e8-df10-4eeb-9757-9fe21abc62a3",
            "migrations_dir": "drizzle",
            "migrations_pattern": "drizzle/*/migration.sql"
        }
    ]
}
